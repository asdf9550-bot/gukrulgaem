# 이 파일을 복사해 .env 로 저장하고 값을 채우세요. .env 는 저장소에 올라가지 않습니다.
# (메모장으로 .env 를 열어 값만 붙여 넣으면 됩니다. 채팅에 키를 붙여 넣지 마세요.)

# 가격 기록(IsThereAnyDeal) — 필수
ITAD_API_KEY=

# "한국인이 싫어한 이유 3줄" — Claude API 키 (없으면 요약 건너뜀)
ANTHROPIC_API_KEY=

# --- 관리자 승인 화면(/admin) ---
# 내 PC: web/.env.local 에, 인터넷 사이트: Vercel 환경 변수에
ADMIN_PASSWORD=
# 어디서나 저장(ㄱ): GitHub 저장소에 커밋. 토큰은 저장소 contents 쓰기 권한만.
GITHUB_TOKEN=
GITHUB_REPO=asdf9550-bot/gukrulgaem
GITHUB_BRANCH=main

# --- 주간 메일(Resend, resend.com 무료 월 3,000통) ---
# Vercel 환경 변수에도 RESEND_API_KEY, RESEND_AUDIENCE_ID 를 넣어야 사이트에서 구독을 받습니다.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
MAIL_FROM=국룰겜 <news@gukrulgaem.com>

# --- 스팀 위시리스트 연동(/me) + 텔레그램 알림 ---
# 스팀 키: https://steamcommunity.com/dev/apikey (도메인 gukrulgaem.com 입력, 무료). Vercel 환경 변수에도 넣기.
STEAM_WEB_API_KEY=
# 텔레그램: @BotFather 에게 /newbot → 이름 국룰겜, 아이디 gukrulgaem_bot → 받은 토큰
TELEGRAM_BOT_TOKEN=
