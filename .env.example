# 이 파일을 복사해 .env 로 저장하고 값을 채우세요. .env 는 저장소에 올라가지 않습니다.
ITAD_API_KEY=

# --- 관리자 승인 화면(/admin) ---
# web/.env.local 에 넣으면 내 PC 미리보기에서, Vercel 환경 변수에 넣으면 인터넷 사이트에서 씁니다.
ADMIN_PASSWORD=
# 어디서나 저장(ㄱ): GitHub 저장소에 커밋. 토큰은 저장소 contents 쓰기 권한만.
GITHUB_TOKEN=
GITHUB_REPO=아이디/저장소이름
GITHUB_BRANCH=main

# 3개월 뒤 기능(리뷰 요약·스팀 계정 연동)에서 씀
ANTHROPIC_API_KEY=
STEAM_WEB_API_KEY=
